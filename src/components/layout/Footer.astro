---
---

<footer class="footer-main">
  <div class="site-container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-8">

      <!-- Logo & Info -->
      <div>
        <div class="flex items-center gap-3 text-white font-bold tracking-tight mb-4">
          <img src="/Logo.png" alt="Ivan's Stump Grinding" class="w-[86px] h-[86px] rounded-full object-cover flex-shrink-0" />
          <span class="flex flex-col">
            <span class="text-2xl leading-none mb-1">IVAN'S</span>
            <span class="text-[11px] tracking-[0.2em] text-primary uppercase leading-none mb-1 font-black">Stump Grinding</span>
            <span class="text-[9px] tracking-[0.1em] text-white/90">QUALITY YOU CAN COUNT ON</span>
          </span>
        </div>
        <p class="mb-5 text-white/75 text-[15px] leading-relaxed">
          Professional stump grinding and tree care services. Quality work, fair prices.
        </p>
        <div class="flex gap-2">
          <a href="#" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Find us on Facebook">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Contact Info -->
      <div>
        <h5 class="footer-heading">Contact Us</h5>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Company:</span> Ivan's Stump Grinding
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Phone:</span>
          <a href="tel:2313429505" class="font-semibold text-white hover:text-primary transition-colors">(231) 342-9505</a>
        </div>
        <div class="footer-contact-item">
          <span class="footer-contact-label">Service Area:</span> Northern Michigan
        </div>
      </div>

      <!-- Hours -->
      <div>
        <h5 class="footer-heading">Business Hours</h5>
        <ul class="business-hours mt-1">
          <li><span>Mon – Fri</span><span>8:00 AM – 6:00 PM</span></li>
          <li><span>Saturday</span><span>8:00 AM – 4:00 PM</span></li>
          <li><span>Sunday</span><span>Closed</span></li>
        </ul>
      </div>

    </div>
  </div>

  <div class="copyright-bar">
    <div class="site-container flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">
      <p class="mb-0 text-[15px]">Copyright &copy; 2026 Ivan's Stump Grinding | Website by <a href="https://schrader.co/" target="_blank" rel="noopener noreferrer" class="font-semibold footer-credit-glow">Schrader Web Solutions</a></p>
      <p class="mb-0 text-[15px]">
        <a href="#" class="hover:text-primary transition-colors">Privacy Policy</a>
        <span class="mx-1">|</span>
        <a href="#" class="hover:text-primary transition-colors">Terms & Conditions</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-main {
    background-color: var(--color-dark-forest);
    color: rgba(255, 255, 255, 0.75);
    padding-block-start: var(--section-space-compact);
    font-family: var(--font-sans);
  }

  .footer-main p {
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-heading {
    font-size: clamp(1rem, calc(0.9rem + 0.35vw), 1.15rem);
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    position: relative;
    padding-block-end: clamp(0.4rem, 0.8vw, 0.5rem);
    margin-block-end: clamp(0.875rem, 1.5vw, 1.125rem);
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(1.75rem, 3vw, 2rem);
    height: 0.15625rem;
    background-color: var(--color-primary);
  }

  .footer-contact-item {
    margin-block-end: clamp(0.5rem, 1vw, 0.625rem);
    line-height: 1.6;
    font-size: clamp(0.9rem, calc(0.84rem + 0.2vw), 0.98rem);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-contact-label {
    font-weight: 600;
    color: #fff;
  }

  .business-hours {
    list-style: none;
    margin: 0;
    padding: 0;
    max-inline-size: min(100%, 18rem);
  }

  .business-hours li {
    display: flex;
    justify-content: space-between;
    gap: clamp(0.35rem, 1vw, 0.5rem);
    margin-block-end: clamp(0.5rem, 1vw, 0.625rem);
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(0.875rem, calc(0.82rem + 0.2vw), 0.95rem);
  }

  .footer-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.5rem, 4vw, 2.625rem);
    height: clamp(2.5rem, 4vw, 2.625rem);
    background-color: var(--color-secondary-forest);
    color: #fff;
    border-radius: 50%;
    transition: transform 0.2s, background-color 0.2s;
    text-decoration: none;
  }

  .footer-social-btn:hover {
    transform: translateY(-2px);
    background-color: var(--color-primary);
  }

  .copyright-bar {
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
    background-color: rgba(0, 0, 0, 0.35);
    color: rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: clamp(1rem, 2vw, 1.125rem);
  }

  .copyright-bar a {
    color: rgba(255, 255, 255, 0.9);
  }

  .footer-credit-glow {
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .footer-credit-glow:hover {
    color: #ffd700;
    text-shadow: 0 0 8px rgba(255, 215, 0, 0.8), 0 0 20px rgba(255, 215, 0, 0.5), 0 0 40px rgba(255, 215, 0, 0.3);
  }

  @media (max-width: 39.999rem) {
    .business-hours li {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
