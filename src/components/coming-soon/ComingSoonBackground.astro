---
---

<div class="coming-soon-background absolute inset-0 z-0 overflow-hidden bg-[var(--color-rich-black)] pointer-events-none">
  <img
    src="/images/hero-coming-soon.webp"
    alt="Stump grinder working in a backyard"
    class="hero-image absolute inset-0 h-full w-full object-cover"
  />

  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_72%_34%,rgba(242,169,0,0.16),transparent_42%)] mix-blend-screen"></div>
  <div class="absolute inset-0 bg-noise mix-blend-overlay opacity-25"></div>
  <div class="hero-overlay absolute inset-0"></div>
</div>

<style>
  .hero-image {
    object-position: center center;
    filter: saturate(1.05) contrast(1.05) brightness(1.05);
  }

  .hero-overlay {
    background:
      linear-gradient(90deg, rgba(3, 3, 3, 0.85) 0%, rgba(3, 3, 3, 0.7) 26%, rgba(3, 3, 3, 0.35) 53%, rgba(3, 3, 3, 0.1) 76%, rgba(3, 3, 3, 0.16) 100%),
      linear-gradient(0deg, rgba(3, 3, 3, 0.5) 0%, rgba(3, 3, 3, 0.06) 48%, rgba(3, 3, 3, 0.2) 100%);
  }

  @media (max-width: 47.999rem) {
    .hero-image {
      object-position: 68% center;
      filter: saturate(1.0) contrast(1.03) brightness(0.95);
    }

    .hero-overlay {
      background: linear-gradient(180deg, rgba(4, 4, 4, 0.24) 0%, rgba(4, 4, 4, 0.14) 55%, rgba(4, 4, 4, 0.62) 100%);
    }
  }
</style>
