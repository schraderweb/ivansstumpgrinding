---
---

<section class="notify-panel" aria-label="Launch notification and contact">
  <div class="notify-panel-inner">
    <div class="notify-intro">
      <span class="notify-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="7" width="24" height="18" rx="2" stroke="currentColor" stroke-width="1.8" /><path d="m5 9 11 9L27 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <span>
        <strong>Be the first to know</strong>
        <small>Subscribe and we'll notify you once we launch.</small>
      </span>
    </div>

    <div class="notify-form-wrap">
      <slot />
    </div>

    <a href="tel:2313429505" class="notify-contact">
      <span class="notify-phone-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M27 22.5v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 9.11 7h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L12.09 13.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 1 2.81.7A2 2 0 0 1 27 22.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <span>
        <small>Need stump grinding now?</small>
        <strong>Call us: <em>(231) 342-9505</em></strong>
        <small>Serving Northern Michigan &amp; surrounding areas</small>
      </span>
    </a>
  </div>
</section>

<style>
  .notify-panel {
    border-block: 1px solid rgba(242, 169, 0, 0.62);
    background: #101010;
    background-image: linear-gradient(90deg, rgba(242, 169, 0, 0.02), transparent 45%, rgba(242, 169, 0, 0.02));
  }

  .notify-panel-inner {
    display: grid;
    grid-template-columns: minmax(15rem, 1.05fr) minmax(19rem, 1.35fr) minmax(17rem, 0.95fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3.25rem);
    width: min(100% - 3rem, 94rem);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 3vw, 2.35rem);
  }

  .notify-intro,
  .notify-contact {
    display: flex;
    align-items: center;
    gap: 1.05rem;
    min-width: 0;
  }

  .notify-icon,
  .notify-phone-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3.15rem;
    height: 3.15rem;
    color: var(--color-gold);
  }

  .notify-icon svg,
  .notify-phone-icon svg {
    width: 100%;
    height: 100%;
  }

  .notify-intro > span:last-child,
  .notify-contact > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .notify-intro strong {
    color: var(--color-white);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .notify-intro small,
  .notify-contact small {
    color: rgba(245, 245, 245, 0.65);
    font-size: clamp(0.72rem, 1vw, 0.85rem);
    line-height: 1.35;
  }

  .notify-form-wrap {
    min-width: 0;
    padding-inline: clamp(0rem, 2vw, 1.5rem);
    border-inline: 1px solid rgba(255, 255, 255, 0.27);
  }

  .notify-contact {
    color: var(--color-white);
    text-decoration: none;
  }

  .notify-contact:hover .notify-phone-icon,
  .notify-contact:focus-visible .notify-phone-icon {
    transform: rotate(-12deg);
  }

  .notify-phone-icon {
    border: 2px solid var(--color-gold);
    border-radius: 50%;
    padding: 0.65rem;
    transition: transform 180ms ease;
  }

  .notify-contact strong {
    color: var(--color-white);
    font-size: clamp(0.9rem, 1.35vw, 1.2rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .notify-contact em {
    color: var(--color-gold);
    font-style: normal;
  }

  @media (max-width: 67.999rem) {
    .notify-panel-inner {
      grid-template-columns: 1fr 1fr;
    }

    .notify-form-wrap {
      grid-column: 1 / -1;
      grid-row: 2;
      padding: 0;
      border-inline: 0;
    }

    .notify-contact {
      justify-self: end;
    }
  }

  @media (max-width: 47.999rem) {
    .notify-panel-inner {
      grid-template-columns: 1fr;
      width: min(100% - 2rem, 94rem);
      gap: 1.25rem;
    }

    .notify-form-wrap,
    .notify-contact {
      grid-column: auto;
      grid-row: auto;
    }

    .notify-contact {
      justify-self: start;
    }
  }
</style>
