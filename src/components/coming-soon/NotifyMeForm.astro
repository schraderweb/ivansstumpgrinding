---
---
<form class="flex flex-col sm:flex-row gap-3 w-full max-w-lg mx-auto animate-fade-up" style="animation-delay: 0.3s;">
  <input 
    type="email" 
    placeholder="Enter your email" 
    required
    class="flex-1 bg-[var(--color-charcoal)] border border-white/10 text-white rounded-lg px-5 py-3 md:py-4 focus:outline-none focus:border-[var(--color-gold)] transition-colors placeholder-[var(--color-gray)] shadow-inner"
  />
  <button 
    type="submit" 
    class="bg-[var(--color-gold)] text-[#111111] font-bold uppercase tracking-wider px-8 py-3 md:py-4 rounded-lg hover:bg-[var(--color-amber)] transition-all hover:-translate-y-0.5 shadow-[0_4px_14px_rgba(242,169,0,0.25)] hover:shadow-[0_6px_20px_rgba(242,169,0,0.4)]"
  >
    Notify Me
  </button>
</form>
