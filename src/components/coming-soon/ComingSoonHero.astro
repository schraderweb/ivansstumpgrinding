---
import ComingSoonBackground from './ComingSoonBackground.astro';
import ComingSoonTypography from './ComingSoonTypography.astro';
import NotifyMeForm from './NotifyMeForm.astro';
import InfoPanel from './InfoPanel.astro';
import FeatureHighlights from './FeatureHighlights.astro';
---

<div class="coming-soon-page selection:bg-[var(--color-gold)] selection:text-[#111111]">
  <section class="coming-soon-hero">
    <ComingSoonBackground />

    <header class="site-header">
      <a href="/" class="brand-lockup" aria-label="Ivan's Stump Grinding home">
        <img src="/Logo.png" alt="Ivan's Stump Grinding" class="brand-mark" />
        <span class="brand-copy">
          <span class="brand-name">IVAN'S</span>
          <span class="brand-service">Stump Grinding</span>
          <span class="brand-tagline">We grind it. You forget it.</span>
        </span>
      </a>

      <a href="tel:2313429505" class="header-phone">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>(231) 342-9505</span>
      </a>
    </header>

    <main class="hero-content">
      <div class="hero-copy">
        <ComingSoonTypography />
        <FeatureHighlights />
      </div>
    </main>
  </section>

  <InfoPanel>
    <NotifyMeForm />
  </InfoPanel>

  <footer class="site-footer">
    <div class="footer-marquee" aria-hidden="true">
      <div class="footer-marquee-track">
        <div class="footer-marquee-group">
          <span>IVAN'S</span>
          <span class="footer-marquee-highlight">STUMP GRINDING CO.</span>
          <span class="footer-marquee-separator">&middot;</span>
        </div>
        <div class="footer-marquee-group">
          <span>IVAN'S</span>
          <span class="footer-marquee-highlight">STUMP GRINDING CO.</span>
          <span class="footer-marquee-separator">&middot;</span>
        </div>
      </div>
    </div>

    <div class="footer-copyright">
      <div class="footer-copyright-inner">
        <p class="footer-copyright-copy">
          <span>&copy; 2026 Ivan's Stump Grinding. All rights reserved.</span>
          <span>Website by <a href="https://schrader.co/" target="_blank" rel="noopener noreferrer">Schrader Web Solutions</a></span>
        </p>

        <div class="footer-meta">
          <nav class="footer-links" aria-label="Footer links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms &amp; Conditions</a>
          </nav>
          <div class="footer-socials" aria-label="Social media">
            <span>Follow us</span>
            <span class="social-icon" aria-label="Facebook">
              <svg aria-hidden="true" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07Z" /></svg>
            </span>
            <span class="social-icon" aria-label="Instagram">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" /><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>

<style>
  .coming-soon-page {
    min-height: 100svh;
    background: var(--color-rich-black);
    color: var(--color-white);
    font-family: var(--font-sans);
  }

  .coming-soon-hero {
    position: relative;
    min-height: clamp(44rem, 79svh, 51rem);
    overflow: hidden;
    isolation: isolate;
  }

  .site-header,
  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 94rem);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1rem, 3vw, 1.75rem);
  }

  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.75rem, 1.4vw, 1.15rem);
    color: var(--color-white);
    text-decoration: none;
  }

  .brand-mark {
    width: clamp(4.5rem, 8vw, 6.75rem);
    height: clamp(4.5rem, 8vw, 6.75rem);
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 2rem rgba(242, 169, 0, 0.18);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-transform: uppercase;
  }

  .brand-name {
    font-family: var(--font-bebas);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    letter-spacing: 0.08em;
    line-height: 0.9;
  }

  .brand-service {
    color: var(--color-gold);
    font-size: clamp(0.6rem, 1vw, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .brand-tagline {
    color: var(--color-white);
    font-size: clamp(0.48rem, 0.75vw, 0.62rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.78;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid var(--color-gold);
    border-radius: 0.55rem;
    color: var(--color-gold);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .header-phone svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .header-phone:hover,
  .header-phone:focus-visible {
    background: var(--color-gold);
    color: #111;
    transform: translateY(-2px);
  }

  .hero-content {
    display: flex;
    align-items: center;
    min-height: calc(clamp(44rem, 79svh, 51rem) - 10rem);
    padding-block: clamp(2rem, 5vh, 3rem) clamp(3rem, 6vh, 3.5rem);
  }

  .hero-copy {
    width: min(100%, 54rem);
  }

  .site-footer {
    width: 100%;
    color: var(--color-gray);
    font-size: 0.75rem;
  }

  .footer-marquee {
    width: 100%;
    overflow: hidden;
    border-block: 1px solid rgba(242, 169, 0, 0.7);
    background: var(--color-gold);
    color: #111;
  }

  .footer-marquee-track {
    display: flex;
    width: max-content;
    animation: footer-marquee 28s linear infinite;
    will-change: transform;
  }

  .footer-marquee-group {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    padding: clamp(0.8rem, 1.6vw, 1.35rem) clamp(1.5rem, 4vw, 4rem);
    white-space: nowrap;
  }

  .footer-marquee-group > span {
    font-family: var(--font-bebas);
    font-size: clamp(2.8rem, 7vw, 7.2rem);
    letter-spacing: 0.045em;
    line-height: 0.78;
  }

  .footer-marquee-highlight {
    color: #1a1a1a;
    text-shadow: 0.06em 0.06em 0 rgba(255, 191, 60, 0.5);
  }

  .footer-marquee-separator {
    color: rgba(17, 17, 17, 0.45);
    font-family: var(--font-sans) !important;
    font-size: clamp(1.8rem, 4vw, 4rem) !important;
    line-height: 1 !important;
  }

  .footer-copyright {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #101010;
  }

  .footer-copyright-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100% - 3rem, 94rem);
    min-height: 5.25rem;
    margin-inline: auto;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-copyright-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    line-height: 1.5;
  }

  .footer-copyright-copy a,
  .footer-links a {
    color: var(--color-white);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-copyright-copy a:hover,
  .footer-copyright-copy a:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-gold);
  }

  .footer-meta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: var(--color-white);
  }

  .social-icon svg {
    width: 1rem;
    height: 1rem;
  }

  @keyframes footer-marquee {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (max-width: 47.999rem) {
    .coming-soon-hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      overflow: visible;
      background: var(--color-rich-black);
    }

    .coming-soon-hero :global(.coming-soon-background) {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(18rem, 49svh, 27rem);
      flex: none;
    }

    .site-header,
    .hero-content {
      width: min(100% - 2rem, 94rem);
    }

    .site-header {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      align-items: flex-start;
    }

    .brand-copy {
      display: none;
    }

    .brand-mark {
      width: 4.8rem;
      height: 4.8rem;
    }

    .header-phone {
      padding: 0.7rem;
      font-size: 0;
    }

    .header-phone svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .hero-content {
      min-height: 0;
      align-items: stretch;
      padding-block: clamp(2rem, 6vw, 3rem) clamp(3rem, 8vw, 4rem);
    }

    .footer-marquee-group {
      gap: 1.25rem;
      padding-inline: 1.25rem;
    }

    .footer-marquee-group > span {
      font-size: clamp(2.7rem, 13vw, 5rem);
    }

    .footer-copyright-inner {
      width: min(100% - 2rem, 94rem);
      flex-direction: column;
      justify-content: center;
      padding-block: 1.35rem;
      text-align: center;
    }

    .footer-copyright-copy {
      flex-direction: column;
      gap: 0.25rem;
    }

    .footer-meta {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-phone {
      transition: none;
    }

    .footer-marquee-track {
      animation: none;
    }
  }
</style>
