---
import ComingSoonBackground from './ComingSoonBackground.astro';
import ComingSoonTypography from './ComingSoonTypography.astro';
import NotifyMeForm from './NotifyMeForm.astro';
import InfoPanel from './InfoPanel.astro';
---
<section class="relative w-full min-h-screen flex flex-col overflow-hidden bg-[var(--color-rich-black)] font-sans selection:bg-[var(--color-gold)] selection:text-[#111111]">
  <ComingSoonBackground />
  
  <!-- Header & Navigation -->
  <header class="relative z-20 w-full pt-8 md:pt-12 pb-6 px-6 md:px-12 max-w-[160rem] mx-auto flex flex-col lg:flex-row items-center justify-between gap-6 animate-fade-down">
    <!-- Logo Area -->
    <div class="flex items-center gap-4 group cursor-pointer">
      <img src="/Logo.png" alt="Ivan's Stump Grinding Logo" class="w-16 h-16 md:w-20 md:h-20 object-contain rounded-full shadow-[0_0_30px_rgba(242,169,0,0.1)] group-hover:shadow-[0_0_40px_rgba(242,169,0,0.2)] transition-shadow" />
      <div class="flex flex-col text-left">
        <span class="text-white font-bebas text-2xl md:text-3xl tracking-wider leading-none mb-1 group-hover:text-[var(--color-gold)] transition-colors">IVAN'S</span>
        <span class="text-[var(--color-gold)] font-black uppercase text-[10px] md:text-xs tracking-[0.2em] leading-none mb-1">Stump Grinding</span>
        <span class="text-[var(--color-gray)] uppercase text-[8px] md:text-[9px] tracking-[0.1em] leading-none">We Grind It. You Forget It.</span>
      </div>
    </div>
    
    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8 lg:gap-12">
      <a href="#" class="text-white text-xs font-semibold uppercase tracking-widest hover:text-[var(--color-gold)] transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-[2px] after:bg-[var(--color-gold)]">Home</a>
      <a href="#" class="text-[var(--color-gray)] text-xs font-semibold uppercase tracking-widest hover:text-[var(--color-white)] transition-colors">Services</a>
      <a href="#" class="text-[var(--color-gray)] text-xs font-semibold uppercase tracking-widest hover:text-[var(--color-white)] transition-colors">About</a>
      <a href="#" class="text-[var(--color-gray)] text-xs font-semibold uppercase tracking-widest hover:text-[var(--color-white)] transition-colors">Contact</a>
    </nav>
  </header>

  <!-- Main Content -->
  <main class="relative z-20 flex-grow flex flex-col items-center justify-center w-full px-4 md:px-8 max-w-7xl mx-auto py-10 md:py-16">
    <ComingSoonTypography />
    <div class="w-full mt-4 md:mt-8">
      <NotifyMeForm />
    </div>
  </main>

  <!-- Bottom Panel -->
  <footer class="relative z-20 w-full px-4 md:px-8 mt-auto">
    <InfoPanel />
    <!-- Footer links -->
    <div class="max-w-[160rem] mx-auto flex flex-col md:flex-row items-center justify-between gap-4 py-6 border-t border-white/5 text-[10px] md:text-xs uppercase tracking-widest text-[var(--color-gray)]">
      <div>&copy; 2026 Ivan's Stump Grinding</div>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms</a>
        <a href="#" class="hover:text-white transition-colors flex items-center gap-1">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg>
          Facebook
        </a>
      </div>
    </div>
  </footer>
</section>
