---
import ComingSoonBackground from './ComingSoonBackground.astro';
import ComingSoonTypography from './ComingSoonTypography.astro';
import NotifyMeForm from './NotifyMeForm.astro';
import InfoPanel from './InfoPanel.astro';
import FeatureHighlights from './FeatureHighlights.astro';
---

<div class="coming-soon-page selection:bg-[var(--color-gold)] selection:text-[#111111]">
  <section class="coming-soon-hero">
    <ComingSoonBackground />

    <header class="site-header">
      <a href="/" class="brand-lockup" aria-label="Ivan's Stump Grinding home">
        <img src="/Logo.webp" alt="Ivan's Stump Grinding" class="brand-mark" />
        <span class="brand-copy">
          <span class="brand-name">IVAN'S</span>
          <span class="brand-service">Stump Grinding</span>
          <span class="brand-tagline">We grind it. You forget it.</span>
        </span>
      </a>

      <a href="tel:2313429505" class="header-phone">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>(231) 342-9505</span>
      </a>
    </header>

    <main class="hero-content">
      <div class="hero-copy">
        <ComingSoonTypography />
        <FeatureHighlights />
      </div>
    </main>
  </section>

  <InfoPanel>
    <NotifyMeForm />
  </InfoPanel>

  <footer class="site-footer">
    <div class="footer-copyright">
      <div class="footer-copyright-inner">
        <p class="footer-copyright-copy">
          <span>&copy; 2026 Ivan's Stump Grinding. All rights reserved.</span>
          <span>Website by <a href="https://schrader.co/" target="_blank" rel="noopener noreferrer">Schrader Web Solutions</a></span>
        </p>

        <div class="footer-meta">
          <nav class="footer-links" aria-label="Footer links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms &amp; Conditions</a>
          </nav>
          <div class="footer-socials" aria-label="Social media">
            <span>Follow us</span>
            <a href="https://www.facebook.com/ivanstumps" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07Z" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>

<style>
  .coming-soon-page {
    min-height: 100svh;
    background: var(--color-rich-black);
    color: var(--color-white);
    font-family: var(--font-sans);
  }

  .coming-soon-hero {
    position: relative;
    min-height: clamp(44rem, 79svh, 51rem);
    overflow: hidden;
    isolation: isolate;
  }

  .site-header,
  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 94rem);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1rem, 3vw, 1.75rem);
  }

  .brand-lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 1.4vw, 1.15rem);
    color: var(--color-white);
    text-decoration: none;
  }

  .brand-mark {
    width: clamp(8rem, 14vw, 13rem);
    height: auto;
    flex: none;
    object-fit: contain;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-transform: uppercase;
    text-align: center;
    transform: translateX(0.3rem);
  }

  .brand-name {
    font-family: var(--font-bebas);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    letter-spacing: 0.08em;
    line-height: 0.9;
  }

  .brand-service {
    color: var(--color-gold);
    font-size: clamp(0.6rem, 1vw, 0.78rem);
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .brand-tagline {
    color: var(--color-white);
    font-size: clamp(0.48rem, 0.75vw, 0.62rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.78;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid var(--color-gold);
    border-radius: 0.55rem;
    background: rgba(17, 17, 17, 0.72);
    color: var(--color-white);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .header-phone svg {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-gold);
  }

  .header-phone:hover,
  .header-phone:focus-visible {
    background: var(--color-gold);
    color: #111;
    transform: translateY(-2px);
  }

  .header-phone:hover svg,
  .header-phone:focus-visible svg {
    color: #111;
  }

  .hero-content {
    display: flex;
    align-items: center;
    min-height: calc(clamp(44rem, 79svh, 51rem) - 10rem);
    padding-block: clamp(2rem, 5vh, 3rem) clamp(3rem, 6vh, 3.5rem);
  }

  .hero-copy {
    width: min(100%, 54rem);
  }

  .site-footer {
    width: 100%;
    color: var(--color-gray);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
  }

  .footer-copyright {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-rich-black);
  }

  .footer-copyright-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(100% - 3rem, 94rem);
    padding-block: clamp(1rem, 1.5vw, 1.5rem);
    margin-inline: auto;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-copyright-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    line-height: 1.5;
    font-size: clamp(0.8rem, 1vw, 0.9rem);
  }

  .footer-copyright-copy a {
    font-weight: 700;
  }

  .footer-copyright-copy a,
  .footer-links a {
    color: var(--color-white);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-copyright-copy a:hover,
  .footer-copyright-copy a:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-gold);
  }

  .footer-meta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .footer-links {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
    font-size: 0.85em;
  }

  .footer-socials {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85em;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: var(--color-white);
  }

  .social-icon svg {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 120rem) and (min-height: 60rem) {
    .coming-soon-hero {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
    }

    .site-header,
    .hero-content {
      width: calc(100% - clamp(4rem, 5vw, 8rem));
      max-width: none;
    }

    .hero-content {
      flex: 1;
      min-height: 0;
      align-items: flex-start;
      padding-block: clamp(4rem, 10vh, 9rem) clamp(3rem, 6vh, 5rem);
    }
  }

  @media (max-width: 47.999rem) {
    .coming-soon-hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      overflow: visible;
      background: var(--color-rich-black);
    }

    .coming-soon-hero :global(.coming-soon-background) {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(18rem, 49svh, 27rem);
      flex: none;
    }

    .site-header,
    .hero-content {
      width: min(100% - 2rem, 94rem);
    }

    .site-header {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      align-items: flex-start;
    }

    .brand-lockup {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      width: max-content;
    }

    .brand-mark {
      width: clamp(6rem, 22vw, 7.5rem);
      height: auto;
    }

    .brand-copy {
      position: static;
      transform: none;
      align-items: center;
      text-align: center;
    }

    .brand-name {
      color: var(--color-gold);
      font-size: clamp(1.4rem, 6vw, 1.9rem);
    }

    .brand-service {
      color: var(--color-white);
      font-size: clamp(0.55rem, 2.5vw, 0.7rem);
    }

    .brand-tagline {
      display: block;
      color: var(--color-gold);
      font-size: clamp(0.5rem, 2.2vw, 0.62rem);
      opacity: 1;
    }

    .header-phone {
      margin-left: auto;
      padding: 0.7rem;
      font-size: 0;
    }

    .header-phone svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .hero-content {
      min-height: 0;
      align-items: stretch;
      padding-block: clamp(2rem, 6vw, 3rem) clamp(3rem, 8vw, 4rem);
    }

    .footer-copyright-inner {
      width: min(100% - 2rem, 94rem);
      flex-direction: column;
      justify-content: center;
      padding-block: 1rem;
      text-align: center;
    }

    .footer-copyright-copy {
      flex-direction: column;
      gap: 0.25rem;
    }

    .footer-meta {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-phone {
      transition: none;
    }
  }
</style>
