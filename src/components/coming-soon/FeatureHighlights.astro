---

<ul class="feature-highlights" aria-label="Our standards">
  <li class="feature-item">
    <span class="feature-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="14" cy="14" r="8" stroke="currentColor" stroke-width="1.8" /><path d="m20 20 7 7M8 19l-3 5m8-3-1 5m5-7 3 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path d="M11 10h6M10 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </span>
    <span class="feature-copy">
      <strong>Stump Grinding</strong>
      <span>Fast, efficient &amp;<br />professional service</span>
    </span>
  </li>

  <li class="feature-item">
    <span class="feature-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 27V15M16 15c-5 0-8-3-8-8 5 0 8 3 8 8Zm0 2c5 0 8-3 8-8-5 0-8 3-8 8Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M10 27h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </span>
    <span class="feature-copy">
      <strong>Safe &amp; Clean</strong>
      <span>We leave your yard<br />clean and level</span>
    </span>
  </li>

  <li class="feature-item">
    <span class="feature-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 4 26 8v7c0 6.1-4.2 10.5-10 13-5.8-2.5-10-6.9-10-13V8l10-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="m11.5 16 3 3 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <span class="feature-copy">
      <strong>Fully Insured</strong>
      <span>Your property is in<br />safe hands</span>
    </span>
  </li>
</ul>

<style>
  .feature-highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, 50rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 1.5vw, 1.15rem);
    min-width: 0;
    padding-inline: clamp(0.75rem, 2vw, 1.6rem);
  }

  .feature-item:first-child {
    padding-inline-start: 0;
  }

  .feature-item + .feature-item {
    border-inline-start: 1px solid rgba(255, 255, 255, 0.42);
  }

  .feature-icon {
    display: inline-flex;
    flex: none;
    width: clamp(2.5rem, 4vw, 3.5rem);
    height: clamp(2.5rem, 4vw, 3.5rem);
    align-items: center;
    justify-content: center;
    color: var(--color-gold);
  }

  .feature-icon svg {
    width: 100%;
    height: 100%;
  }

  .feature-copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .feature-copy strong {
    color: var(--color-white);
    font-size: clamp(0.72rem, 1.15vw, 0.95rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .feature-copy span {
    color: rgba(245, 245, 245, 0.76);
    font-size: clamp(0.7rem, 1vw, 0.86rem);
    line-height: 1.5;
  }

  @media (max-width: 47.999rem) {
    .feature-highlights {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      width: min(100%, 22rem);
      margin-inline: auto;
    }

    .feature-item,
    .feature-item:first-child {
      padding-inline: 0;
    }

    .feature-item + .feature-item {
      padding-block-start: 1.2rem;
      border-inline-start: 0;
      border-block-start: 1px solid rgba(255, 255, 255, 0.25);
    }
  }
</style>
