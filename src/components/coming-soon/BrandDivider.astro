---
interface Props {
  label?: string;
  icon?: boolean;
}

const { label, icon = false } = Astro.props;
---

<div class:list={['brand-divider', { 'brand-divider--label': label, 'brand-divider--icon': icon }]}>
  <span class="divider-line divider-line--left"></span>
  {label && <span class="divider-label">{label}</span>}
  {icon && (
    <svg aria-hidden="true" class="divider-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 23h16M10 23v-5m12 5v-5M12 18h8l-1.4-7h-5.2L12 18Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M9 11h14M13 8h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )}
  <span class="divider-line divider-line--right"></span>
</div>

<style>
  .brand-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.8vw, 1.4rem);
    width: min(100%, 31rem);
    margin-inline: auto;
    color: var(--color-gold);
  }

  .divider-line {
    display: block;
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, var(--color-gold));
    opacity: 0.75;
  }

  .divider-line--right {
    background: linear-gradient(90deg, var(--color-gold), transparent);
  }

  .divider-label {
    color: var(--color-white);
    font-size: clamp(0.7rem, 1.5vw, 1.15rem);
    font-weight: 600;
    letter-spacing: clamp(0.25em, 0.65vw, 0.5em);
    margin-right: calc(-1 * clamp(0.25em, 0.65vw, 0.5em));
    text-transform: uppercase;
    white-space: nowrap;
  }

  .divider-icon {
    width: clamp(1.8rem, 3vw, 2.35rem);
    height: clamp(1.8rem, 3vw, 2.35rem);
    flex: none;
  }

  .brand-divider--icon {
    width: min(100%, 33rem);
    margin-inline: auto;
  }

  @media (max-width: 47.999rem) {
    .divider-label {
      letter-spacing: 0.27em;
      margin-right: -0.27em;
    }
  }
</style>
