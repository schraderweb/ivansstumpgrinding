---
import BrandDivider from './BrandDivider.astro';
---
<div class="flex flex-col items-center justify-center text-center animate-fade-down" style="animation-delay: 0.1s;">
  <BrandDivider />
  
  <h1 class="font-bebas uppercase leading-[0.9] tracking-[2px] mt-6 md:mt-8 mb-4 md:mb-6 drop-shadow-[0_6px_25px_rgba(0,0,0,0.45)] text-grunge-mask flex flex-col md:flex-row gap-0 md:gap-5" style="font-size: clamp(90px, 12vw, 180px);">
    <span class="bg-clip-text text-transparent bg-gradient-to-b from-[#FFFFFF] via-[#F1F1F1] to-[#D5D5D5]">COMING</span>
    <span class="bg-clip-text text-transparent bg-gradient-to-b from-[#FFCA45] via-[#F2A900] to-[#C98300]">SOON</span>
  </h1>
  
  <h2 class="text-[var(--color-white)] text-sm md:text-lg lg:text-2xl uppercase tracking-[0.3em] md:tracking-[0.45em] font-medium mb-8 md:mb-10 max-w-3xl drop-shadow-md">
    Our new website is under construction.
  </h2>
</div>
